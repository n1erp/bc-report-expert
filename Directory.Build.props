<Project>
  <PropertyGroup>
    <!-- Default TFM; WPF/WinForms projects override to net10.0-windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Authors>N1ERP</Authors>
    <Company>N1ERP</Company>
    <Copyright>Copyright (c) 2026 N1ERP</Copyright>
    <Version>2.0.0</Version>
    <!-- rex-2.0-baboon. VersionDisplay and VersionCodename name the installer and ZIP. -->
    <VersionDisplay>2.0</VersionDisplay>
    <VersionCodename>Baboon</VersionCodename>
    <InformationalVersion>rex-2.0-baboon</InformationalVersion>
    <Product>Report Expert</Product>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
</Project>
