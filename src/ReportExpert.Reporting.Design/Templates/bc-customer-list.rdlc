                    <TablixCell><CellContents><Textbox Name="Name_Customer"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Name_Customer.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>#E4EAF0</Color><Style>Solid</Style></Border><PaddingLeft>4pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
