<UserControl x:Class="ReportExpert.App.Reports.ReportDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:ReportExpert.App.Reports"
             xmlns:design="clr-namespace:ReportExpert.Reporting.Design;assembly=ReportExpert.Reporting.Design"
             TextElement.FontFamily="{StaticResource Safi.FontFamily}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:NullToVisibilityConverter x:Key="NullToVis" />
        <local:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
        <Style x:Key="PaneToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Safi.TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="5" Padding="{TemplateBinding Padding}" BorderThickness="1"
                                BorderBrush="{DynamicResource Safi.DividerBrush}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Safi.ChipBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Safi.PrimaryLightenBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="GroupChip" DataType="{x:Type design:DesignGroup}">
            <Border Style="{StaticResource Safi.Chip}" Margin="0,4,6,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Safi.Caption}" ToolTip="{Binding Expression}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Safi.OutlinedButton}" BorderThickness="0" Padding="3,0" Margin="4,0,0,0" ToolTip="Remove group"
                            Command="{Binding DataContext.RemoveGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="11" />
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource Safi.OutlinedButton}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Safi.TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Safi.SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Safi.ChipBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Safi.PrimaryLightenBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Left panel tabs (Report data | Widgets) -->
        <Style x:Key="PaneTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Safi.TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="10,7" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Safi.PrimaryLightenBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Safi.TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <HierarchicalDataTemplate x:Key="DataNodeTemplate" DataType="{x:Type local:ReportDataNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2" ToolTip="{Binding Expression}" Tag="{Binding DropKind}">
                <ui:SymbolIcon FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource Safi.PrimaryLightenBrush}">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="TextField24" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Folder"><Setter Property="Symbol" Value="Folder24" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Parameter"><Setter Property="Symbol" Value="Braces24" /></DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Global"><Setter Property="Symbol" Value="Globe24" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <TextBlock Text="{Binding Label}" FontSize="12.5" />
            </StackPanel>
        </HierarchicalDataTemplate>
        <Style x:Key="ToolSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource Safi.DividerBrush}" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar: file, clipboard, history, zoom, align, layout, bands, view, preview -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Safi.DividerBrush}" Padding="8,6">
            <DockPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleToolboxCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsToolboxOpen, Converter={StaticResource InverseBoolToVis}}" ToolTip="Show the Report data and Widgets panel">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PanelLeft24" FontSize="17" Margin="0,0,4,0" /><TextBlock Text="Data &amp; widgets" /></StackPanel>
                    </Button>
                    <TextBlock Text="{Binding DocumentTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource Safi.TextPrimaryBrush}" MaxWidth="260" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasDocumentTitle, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Current.SourcePath}" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding EffectiveSaveCommand}" ToolTip="Save the RDLC (Ctrl+S); the previous version is kept as .bak"><ui:SymbolIcon Symbol="Save24" FontSize="17" /></Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding HostReloadCommand}" Visibility="{Binding HasHostReload, Converter={StaticResource BoolToVis}}" ToolTip="Reload from disk"><ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="17" /></Button>
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding CutItemCommand}" ToolTip="Cut"><ui:SymbolIcon Symbol="Cut24" FontSize="17" /></Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding CopyItemCommand}" ToolTip="Copy"><ui:SymbolIcon Symbol="Copy24" FontSize="17" /></Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding PasteItemCommand}" IsEnabled="{Binding Current.HasClipboard}" ToolTip="Paste"><ui:SymbolIcon Symbol="ClipboardPaste24" FontSize="17" /></Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteItemCommand}" ToolTip="Delete (Del)"><ui:SymbolIcon Symbol="Delete24" FontSize="17" /></Button>
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding UndoCommand}" IsEnabled="{Binding Current.CanUndo}" ToolTip="Undo (Ctrl+Z)"><ui:SymbolIcon Symbol="ArrowUndo24" FontSize="17" /></Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding RedoCommand}" IsEnabled="{Binding Current.CanRedo}" ToolTip="Redo (Ctrl+Y)"><ui:SymbolIcon Symbol="ArrowRedo24" FontSize="17" /></Button>
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out"><ui:SymbolIcon Symbol="ZoomOut24" FontSize="17" /></Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomResetCommand}" ToolTip="Reset zoom"><TextBlock Text="{Binding ZoomText}" MinWidth="40" TextAlignment="Center" /></Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ZoomInCommand}" ToolTip="Zoom in"><ui:SymbolIcon Symbol="ZoomIn24" FontSize="17" /></Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnZoomToWidth" ToolTip="Zoom to page width"><ui:SymbolIcon Symbol="ScaleFit24" FontSize="17" /></Button>
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding PageSetupCommand}"
                            ToolTip="Page setup&#x0a;Paper size, orientation, margins and columns">
                        <ui:SymbolIcon Symbol="DocumentMargins24" FontSize="17" />
                    </Button>
                    <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding ShowPlaceholders}"
                                  ToolTip="Placeholders&#x0a;On: show expressions as [Field], [@Parameter] and «Expr». Off: show the full expressions.">
                        <ui:SymbolIcon Symbol="Braces24" FontSize="16" />
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding ShowHiddenItems}"
                                  ToolTip="Hidden items&#x0a;On: show items that are hidden at run time, dimmed. Off: remove them so what is underneath can be selected.">
                        <ui:SymbolIcon Symbol="Eye24" FontSize="16" />
                    </ToggleButton>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Format toolbar: applies to every selected text box or cell, as one undo step. -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Safi.DividerBrush}" Padding="8,4"
                Background="{DynamicResource Safi.BackgroundBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionReadout}" VerticalAlignment="Center" Margin="12,0,4,0"
                           FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{DynamicResource Safi.TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionReadout}" />
                <WrapPanel VerticalAlignment="Center" IsEnabled="{Binding CanFormat}">
                    <ComboBox x:Name="FontFamilyBox" Width="150" Margin="0,0,4,0" ItemsSource="{Binding FontFamilies}"
                              SelectedItem="{Binding FormatFontFamily, Mode=OneWay}" SelectionChanged="OnFontFamilyPicked" ToolTip="Font" />
                    <ComboBox x:Name="FontSizeBox" Width="74" Margin="0,0,6,0" ItemsSource="{Binding FontSizes}"
                              SelectedItem="{Binding FormatFontSize, Mode=OneWay}" SelectionChanged="OnFontSizePicked" ToolTip="Font size" />
                    <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding IsBold, Mode=OneWay}" Command="{Binding ToggleBoldCommand}" ToolTip="Bold"><ui:SymbolIcon Symbol="TextBold24" FontSize="16" /></ToggleButton>
                    <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding IsItalic, Mode=OneWay}" Command="{Binding ToggleItalicCommand}" ToolTip="Italic"><ui:SymbolIcon Symbol="TextItalic24" FontSize="16" /></ToggleButton>
                    <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding IsUnderline, Mode=OneWay}" Command="{Binding ToggleUnderlineCommand}" ToolTip="Underline"><ui:SymbolIcon Symbol="TextUnderline24" FontSize="16" /></ToggleButton>
                    <Button Style="{StaticResource ToolButton}" Click="OnColorMenu" ToolTip="Text colour"><ui:SymbolIcon Symbol="TextColor24" FontSize="16" /></Button>
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Command="{Binding SetFormatCommand}" CommandParameter="TextAlign|Left" ToolTip="Align text left"><ui:SymbolIcon Symbol="TextAlignLeft24" FontSize="16" /></Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding SetFormatCommand}" CommandParameter="TextAlign|Center" ToolTip="Center text"><ui:SymbolIcon Symbol="TextAlignCenter24" FontSize="16" /></Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding SetFormatCommand}" CommandParameter="TextAlign|Right" ToolTip="Align text right"><ui:SymbolIcon Symbol="TextAlignRight24" FontSize="16" /></Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding SetFormatCommand}" CommandParameter="VerticalAlign|Top" ToolTip="Align to top"><ui:SymbolIcon Symbol="AlignTop24" FontSize="16" /></Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding SetFormatCommand}" CommandParameter="VerticalAlign|Middle" ToolTip="Align to middle"><ui:SymbolIcon Symbol="AlignCenterVertical24" FontSize="16" /></Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding SetFormatCommand}" CommandParameter="VerticalAlign|Bottom" ToolTip="Align to bottom"><ui:SymbolIcon Symbol="AlignBottom24" FontSize="16" /></Button>
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button Style="{StaticResource ToolButton}" Click="OnNumberFormatMenu" ToolTip="Number and date format">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="NumberSymbol24" FontSize="16" Margin="0,0,4,0" /><TextBlock Text="Format" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding EditValueCommand}" ToolTip="Edit the value in the expression editor (double-click a text box)">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="MathFormula24" FontSize="16" Margin="0,0,4,0" /><TextBlock Text="Expression" /></StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Blank-page warning: body wider than page − margins. -->
        <Border DockPanel.Dock="Top" Padding="12,7" Background="#22E5484D" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Safi.ErrorBrush}"
                Visibility="{Binding HasPageWarning, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource Safi.PrimaryButton}" Command="{Binding FitBodyToPageCommand}" Content="Fit body to page" Padding="10,3" Margin="0,0,6,0" />
                    <Button Style="{StaticResource Safi.OutlinedButton}" Command="{Binding PageSetupCommand}" Content="Page setup…" Padding="10,3" Margin="0" />
                </StackPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource Safi.ErrorBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PageWarning}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Safi.TextPrimaryBrush}" />
            </DockPanel>
        </Border>

        <!-- Grouping pane (bottom), as in Report Builder: Row Groups | Column Groups, right-click for the group commands -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Safi.DividerBrush}" Padding="10,6"
                Visibility="{Binding HasGroupTarget, Converter={StaticResource BoolToVis}}">
            <Border.Resources>
                <ContextMenu x:Key="GroupingMenu" x:Shared="False"
                             DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Add Group">
                        <MenuItem Header="Parent Group..." Command="{Binding AddParentGroupCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Child Group..." Command="{Binding AddChildGroupCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <Separator />
                        <MenuItem Header="Adjacent Before..." Command="{Binding AddAdjacentBeforeCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Adjacent After..." Command="{Binding AddAdjacentAfterCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </MenuItem>
                    <MenuItem Header="Add Total">
                        <MenuItem Header="Before" Command="{Binding AddTotalBeforeCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="After" Command="{Binding AddTotalAfterCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </MenuItem>
                    <MenuItem Header="Delete Group..." Command="{Binding DeleteGroupNodeCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="Show / Hide" ToolTip="Initial visibility of this group or static row" Command="{Binding ToggleMemberHiddenCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Repeat on new page" ToolTip="Static rows only: repeat this row on every page" Command="{Binding ToggleRepeatOnNewPageCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="Group Properties..." Command="{Binding GroupPropertiesCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
                <HierarchicalDataTemplate x:Key="GroupingLine" DataType="{x:Type local:GroupingNode}" ItemsSource="{Binding Children}">
                    <Border Background="Transparent" Padding="2,1" ToolTip="{Binding ToolTip}" ContextMenu="{StaticResource GroupingMenu}"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Border>
                </HierarchicalDataTemplate>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Row Groups" Style="{StaticResource Safi.Caption}" FontWeight="SemiBold" />
                    <TreeView ItemsSource="{Binding RowGroupNodes}" ItemTemplate="{StaticResource GroupingLine}" MaxHeight="150" MinHeight="44"
                              Background="Transparent" BorderThickness="0" ToolTip="Right-click a group: Add Group, Add Total, Delete Group, Group Properties">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Column Groups" Style="{StaticResource Safi.Caption}" FontWeight="SemiBold" />
                    <TreeView ItemsSource="{Binding ColumnGroupNodes}" ItemTemplate="{StaticResource GroupingLine}" MaxHeight="150" MinHeight="44"
                              Background="Transparent" BorderThickness="0" ToolTip="Right-click a group: Add Group, Add Total, Delete Group, Group Properties">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="True" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Top" Margin="8,0,0,0">
                    <CheckBox Content="Advanced mode" IsChecked="{Binding ShowStaticMembers}" Margin="0,0,0,6"
                              ToolTip="Also list static members (header, footer and total rows) so their visibility and paging can be set" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="170" Margin="0,0,6,0" ItemsSource="{Binding SelectedDataSet.Fields}" DisplayMemberPath="Name" SelectedValuePath="Name" SelectedValue="{Binding GroupField}" ToolTip="Field to group by" />
                        <Button Style="{StaticResource Safi.OutlinedButton}" Command="{Binding AddRowGroupAtCellCommand}" CommandParameter="Parent" Content="+ Row group" ToolTip="Add a parent row group (around the selected cell's group)" />
                        <Button Style="{StaticResource Safi.OutlinedButton}" Command="{Binding AddColumnGroupAtCellCommand}" CommandParameter="Parent" Content="+ Column group" Margin="0" ToolTip="Add a parent column group" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ToolboxColumn" Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Toolbox -->
            <Border x:Name="ToolboxPanel" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Safi.DividerBrush}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,4,6,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="0" Command="{Binding ToggleToolboxCommand}" ToolTip="Hide this panel">
                            <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="16" />
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DataTabButton" Style="{StaticResource PaneTab}" GroupName="leftpane" IsChecked="True" Content="Report data"
                                         ToolTip="Built-in fields, parameters and dataset fields — drag onto the page or double-click to insert" />
                            <RadioButton x:Name="WidgetsTabButton" Style="{StaticResource PaneTab}" GroupName="leftpane" Content="Widgets" ToolTip="Text boxes, tables, charts and bands" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Report Data pane (Report Builder): built-in fields, parameters, datasets and their fields. -->
                    <TreeView x:Name="ReportDataTree" Margin="4,8,4,4" BorderThickness="0" Background="Transparent"
                              ItemsSource="{Binding ReportData}" ItemTemplate="{StaticResource DataNodeTemplate}"
                              Visibility="{Binding IsChecked, ElementName=DataTabButton, Converter={StaticResource BoolToVis}}"
                              PreviewMouseLeftButtonDown="OnDataPress" PreviewMouseMove="OnDataDrag" MouseDoubleClick="OnDataInsert">
                        <TreeView.ItemContainerStyle>
                            <!-- Folders start collapsed; whatever the user opens stays open (remembered across sessions). -->
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <DockPanel Visibility="{Binding IsChecked, ElementName=WidgetsTabButton, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="8">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PaneToggle}" IsChecked="{Binding IsToolboxAlphabetical}" Margin="6,0,0,0"
                                      ToolTip="Alphabetical list (off: grouped by category)">
                            <TextBlock Text="A–Z" FontSize="11.5" FontWeight="SemiBold" />
                        </ToggleButton>
                        <ui:TextBox PlaceholderText="Search items" Icon="{ui:SymbolIcon Search24}"
                                    Text="{Binding ToolboxSearch, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                        <ItemsControl ItemsSource="{Binding Toolbox}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ToolboxGroup}">
                                    <Expander Header="{Binding Name}" IsExpanded="True" Margin="6,0,6,4">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:ToolboxEntry}">
                                                    <Button Style="{StaticResource Safi.OutlinedButton}" Margin="2" Padding="4,8" BorderThickness="1"
                                                            Command="{Binding DataContext.PlaceToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" PreviewMouseLeftButtonDown="OnToolPress" PreviewMouseMove="OnToolDrag" Tag="{Binding Kind}"
                                                            ToolTip="Click to add, or drag onto the page">
                                                        <StackPanel>
                                                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Foreground="{DynamicResource Safi.PrimaryLightenBrush}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="Normal" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- Surface -->
            <local:DesignSurfaceControl Grid.Column="1" Background="{DynamicResource Safi.BackgroundBrush}" Focusable="True" x:Name="Surface" />

        </Grid>
    </DockPanel>
</UserControl>
