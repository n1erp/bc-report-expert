<ui:FluentWindow x:Class="ReportExpert.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:preview="clr-namespace:ReportExpert.Modules.Preview.Views;assembly=ReportExpert.Modules.Preview"
                 xmlns:home="clr-namespace:ReportExpert.App.Home"
                 xmlns:ws="clr-namespace:ReportExpert.App.Workspace"
                 xmlns:reports="clr-namespace:ReportExpert.App.Reports"
                 Title="{Binding WindowTitle}"
                 Icon="pack://application:,,,/Assets/app-icon.ico"
                 Height="860"
                 Width="1360"
                 MinHeight="640"
                 MinWidth="1000"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Maximized"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource Safi.BackgroundBrush}"
                 TextElement.FontFamily="{StaticResource Safi.FontFamily}">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <reports:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <reports:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True" />
        <Style x:Key="WorkspacePanelToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{DynamicResource Safi.TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Safi.SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Safi.ChipBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- App bar toggle (Settings gear): lit while its page is open. -->
        <Style x:Key="AppBarToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Safi.AppBarTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent"
                                BorderThickness="1" BorderBrush="{DynamicResource Safi.OverlaySelectedBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Safi.OverlaySelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Safi.OverlaySelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Collapsed workspace panel: a vertical "Reports" tab (Visual Studio auto-hide style). -->
        <Style x:Key="SideTab" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Safi.TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" BorderThickness="0,0,2,0" BorderBrush="Transparent" Padding="0,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Safi.SurfaceHoverBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Safi.PrimaryLightenBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource Safi.TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- App bar (SafiPay AppBar): navy, product name, workspace, theme switcher -->
        <ui:TitleBar Grid.Row="0"
                     Height="52"
                     Background="{DynamicResource Safi.AppBarBackgroundBrush}"
                     ButtonsForeground="{DynamicResource Safi.AppBarTextBrush}"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <ui:ImageIcon x:Name="AppLogo" Width="22" Height="22" Margin="8,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Report Expert" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Safi.AppBarTextBrush}" />
                    <Border CornerRadius="10" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource Safi.OverlaySelectedBrush}">
                        <TextBlock Text="2 Baboon" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Safi.AppBarTextBrush}" />
                    </Border>
                    <TextBlock Text="{Binding WorkspaceName}" FontSize="13" Margin="18,0,0,0" VerticalAlignment="Center" Opacity="0.85"
                               Foreground="{DynamicResource Safi.AppBarTextBrush}"
                               Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <!-- Settings (the theme is chosen there): click again to return to the editor. -->
                <ToggleButton x:Name="NavSettings" Style="{StaticResource AppBarToggle}" Margin="0,0,10,0" VerticalAlignment="Center"
                              ToolTip="Settings — theme, AI providers, MCP servers, designer" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="17" Foreground="{DynamicResource Safi.AppBarTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" Margin="7,0,2,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Safi.AppBarTextBrush}" />
                    </StackPanel>
                </ToggleButton>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DrawerColumn" Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Workspace panel: the AL project's layouts. The « button collapses it to the vertical Reports tab. -->
            <Border x:Name="DrawerPanel" Grid.Column="0" Background="{DynamicResource Safi.SurfaceBrush}"
                    BorderBrush="{DynamicResource Safi.DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <DockPanel DockPanel.Dock="Top" Margin="16,18,10,0"
                               Visibility="{Binding HasWorkspace, Converter={StaticResource InverseBoolToVis}}">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Safi.OutlinedButton}" BorderThickness="0" Padding="6,4" Margin="0"
                                    Click="OnCollapseDrawer" ToolTip="Collapse the panel">
                                <ui:SymbolIcon Symbol="ChevronDoubleLeft20" FontSize="13" />
                            </Button>
                            <TextBlock Text="WORKSPACE" FontSize="11" FontWeight="SemiBold" Opacity="0.65" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Safi.TextSecondaryBrush}" />
                        </DockPanel>
                        <StackPanel>
                            <TextBlock Text="Open an AL extension folder to list its reports and layouts."
                                       Margin="0,6,6,12" TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{DynamicResource Safi.TextSecondaryBrush}" />
                            <Button Style="{StaticResource Safi.PrimaryButton}" Command="{Binding OpenProjectCommand}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,6,0" />
                                    <TextBlock Text="Open folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <ws:WorkspaceExplorerView x:Name="WorkspaceExplorer"
                                              Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVis}}" />
                </DockPanel>
            </Border>

            <Border x:Name="ReportsTab" Grid.Column="0" Visibility="Collapsed" Background="{DynamicResource Safi.SurfaceBrush}"
                    BorderBrush="{DynamicResource Safi.DividerBrush}" BorderThickness="0,0,1,0">
                <Button Style="{StaticResource SideTab}" Click="OnExpandDrawer" ToolTip="Show the reports panel" VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </StackPanel.LayoutTransform>
                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="15" Margin="0,0,8,0">
                            <ui:SymbolIcon.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </ui:SymbolIcon.LayoutTransform>
                        </ui:SymbolIcon>
                        <TextBlock Text="Reports" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Border>

            <!-- Content: the workspace editor (designer, AL, Excel, Word, Copilot) or Settings -->
            <Grid Grid.Column="1">
                <home:HomeView x:Name="HomeFeature"
                               Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource InverseBoolToVis}}" />
                <preview:SettingsView x:Name="SettingsFeature"
                                      Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>

        <!-- Status bar: the open report on the left, the designer's last message on the right. -->
        <Border Grid.Row="2" Background="{DynamicResource Safi.SurfaceBrush}" BorderBrush="{DynamicResource Safi.DividerBrush}"
                BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <Border DockPanel.Dock="Right" Visibility="{Binding HomeViewer.IsRdlcLayout, Converter={StaticResource BoolToVis}}">
                <StackPanel x:Name="DesignerStatus" Orientation="Horizontal">
                    <ProgressBar Width="90" Height="4" IsIndeterminate="True" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Status}" FontSize="12" VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Status}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Safi.TextSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Safi.ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedFile, Converter={StaticResource NotNullToVis}}">
                    <ui:SymbolIcon Symbol="DocumentRibbon24" FontSize="14" Foreground="{DynamicResource Safi.PrimaryLightenBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedFile.Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Safi.TextPrimaryBrush}" />
                    <TextBlock Text="{Binding SelectedFile.DisplayPath}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Safi.TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
