<UserControl x:Class="ReportExpert.Modules.Copilot.Views.CopilotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:ReportExpert.Modules.Copilot.Helpers">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <helpers:UserToAlignmentConverter x:Key="UserToAlignment" />

        <!-- Composer chip: thumbnail (image) or icon (file), name, type · size, remove. -->
        <DataTemplate x:Key="PendingAttachmentTemplate">
            <Border Margin="0,0,6,6" Padding="4,4,2,4" CornerRadius="8" ToolTip="{Binding ToolTip}"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="5" ClipToBounds="True"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                   Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="8,0,4,0" VerticalAlignment="Center" MaxWidth="150">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ui:Button Appearance="Transparent" Padding="4" VerticalAlignment="Center" ToolTip="Remove"
                               Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Dismiss12" FontSize="11" />
                    </ui:Button>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Sent message: images as small previews, files as chips. -->
        <DataTemplate x:Key="SentAttachmentTemplate">
            <Grid Margin="0,0,6,6" ToolTip="{Binding ToolTip}">
                <Border CornerRadius="6" ClipToBounds="True" MaxWidth="200" MaxHeight="140"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                </Border>
                <Border Padding="8,5" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.55" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- VS Code agent-style: assistant = flat text; user = soft chip -->
        <DataTemplate x:Key="ChatMessageTemplate">
            <Grid Margin="0,8"
                  HorizontalAlignment="{Binding IsUser, Converter={StaticResource UserToAlignment}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Rex author row -->
                <StackPanel Orientation="Horizontal" Margin="2,0,0,4"
                            Visibility="{Binding IsUser, Converter={StaticResource InverseBoolToVis}}">
                    <ui:SymbolIcon Symbol="BotSparkle24" FontSize="16"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding Author}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="0"
                           Text="{Binding Author}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Opacity="0.45"
                           HorizontalAlignment="Right"
                           Margin="0,0,4,4"
                           Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}" />

                <!-- User chip -->
                <Border Grid.Row="1"
                        MaxWidth="440"
                        Padding="12,8"
                        CornerRadius="10"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Attachments}" ItemTemplate="{StaticResource SentAttachmentTemplate}"
                                      Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <helpers:MarkdownViewer Markdown="{Binding Content}"
                                                FontSize="13"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Visibility="{Binding ShowMarkdown, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Assistant: width follows the chat pane -->
                <Grid Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      Visibility="{Binding IsUser, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Text="Thinking…"
                               FontSize="13"
                               FontStyle="Italic"
                               Opacity="0.65"
                               Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}" />

                    <helpers:MarkdownViewer Markdown="{Binding Content}"
                                            FontSize="13"
                                            HorizontalAlignment="Stretch"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Visibility="{Binding ShowMarkdown, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Tool call card -->
        <DataTemplate x:Key="ToolCallTemplate">
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,6">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ShieldTask24" FontSize="14"
                                           Visibility="{Binding IsAwaitingApproval, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14"
                                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14"
                                           Foreground="#FF107C10"
                                           Visibility="{Binding IsSucceeded, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="14"
                                           Foreground="#FFC42B1C"
                                           Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="DismissCircle24" FontSize="14"
                                           Opacity="0.55"
                                           Visibility="{Binding IsDenied, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="LockClosed24" FontSize="14"
                                           Opacity="0.7"
                                           Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ToolName}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       FontFamily="Consolas"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="10"
                                       Opacity="0.55" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing Width="14" Height="14"
                                             IsIndeterminate="True"
                                             Margin="0,0,4,0"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            <ui:Button Appearance="Transparent"
                                       Padding="6,2"
                                       ToolTip="Show details"
                                       Command="{Binding ToggleDetailsCommand}">
                                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding Summary}"
                               Margin="26,6,0,0"
                               FontSize="11"
                               Opacity="0.75"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}" />

                    <Border Margin="26,8,0,0"
                            Padding="8,6"
                            CornerRadius="6"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding Arguments, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 HorizontalScrollBarVisibility="Auto"
                                 MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Margin="26,10,0,0"
                                Visibility="{Binding IsAwaitingApproval, Converter={StaticResource BoolToVis}}">
                        <ui:Button Content="Confirm once"
                                   Appearance="Primary"
                                   Padding="12,4"
                                   Margin="0,0,6,0"
                                   ToolTip="Allow only this change"
                                   Command="{Binding ApproveOnceCommand}" />
                        <ui:Button Content="Confirm always"
                                   Padding="12,4"
                                   Margin="0,0,6,0"
                                   ToolTip="Allow this and every later change until you restart or turn agent mode off"
                                   Command="{Binding ApproveAlwaysCommand}" />
                        <ui:Button Content="Decline"
                                   Padding="12,4"
                                   Command="{Binding DenyCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <helpers:CopilotMessageTemplateSelector x:Key="MessageTemplateSelector"
                                                ChatTemplate="{StaticResource ChatMessageTemplate}"
                                                ToolCallTemplate="{StaticResource ToolCallTemplate}" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="14,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="BotSparkle24" FontSize="20"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Rex"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ReportContextDisplay}"
                               Margin="30,4,0,0"
                               FontSize="11"
                               Opacity="0.55"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat: constrain width to the viewport so messages grow when the pane is stretched -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ChatScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="14,8">
            <ItemsControl ItemsSource="{Binding Messages}"
                          Width="{Binding ViewportWidth, ElementName=ChatScroll}"
                          ItemTemplateSelector="{StaticResource MessageTemplateSelector}">
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </ScrollViewer>

        <!-- Busy strip -->
        <Border Grid.Row="2"
                Margin="12,0,12,8"
                Padding="10,8"
                CornerRadius="8"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right"
                           Content="Stop"
                           Appearance="Transparent"
                           Padding="10,2"
                           VerticalAlignment="Center"
                           Command="{Binding StopCommand}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="BotSparkle24" FontSize="16"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ui:ProgressRing Width="14" Height="14"
                                     IsIndeterminate="True"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BusyStatusText}"
                               FontSize="12"
                               Opacity="0.8"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Composer -->
        <Border Grid.Row="3"
                Padding="12,10"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Composer box: attachments, live dictation, input, and the attach / voice / send row.
                     Files can also be dropped here, and a screenshot pasted with Ctrl+V. -->
                <Border x:Name="ComposerBox"
                        CornerRadius="10"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        AllowDrop="True"
                        DragEnter="ComposerBox_DragOver"
                        DragOver="ComposerBox_DragOver"
                        DragLeave="ComposerBox_DragLeave"
                        Drop="ComposerBox_Drop">
                    <StackPanel>
                        <!-- No usable provider: say so, and offer the way to fix it. -->
                        <Border Margin="8,8,8,0" Padding="12,10" CornerRadius="8"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding NeedsProviderSetup, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Key24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <StackPanel>
                                    <TextBlock Text="Connect an AI provider" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SetupMessage}" FontSize="11.5" Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,8" />
                                    <ui:Button Content="Open Settings" Appearance="Primary" Padding="12,4" HorizontalAlignment="Left"
                                               Command="{Binding OpenSettingsCommand}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PendingAttachments}"
                                      ItemTemplate="{StaticResource PendingAttachmentTemplate}"
                                      Margin="8,8,8,0"
                                      Visibility="{Binding HasPendingAttachments, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Listening strip -->
                        <Border Margin="8,8,8,0" Padding="10,6" CornerRadius="6"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="8,2" Content="Stop"
                                           Command="{Binding ToggleVoiceCommand}" ToolTip="Stop listening" />
                                <Ellipse Width="9" Height="9" Fill="#FFE5484D" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Listening — speak in English. Text appears in the box for you to edit." FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VoiceHypothesis}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" Opacity="0.9" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ui:TextBox x:Name="InputBox"
                                    Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Ask Rex to help you with the layout"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="48"
                                    MaxHeight="160"
                                    VerticalContentAlignment="Top"
                                    Padding="10,8"
                                    Margin="2,2,2,0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    VerticalScrollBarVisibility="Auto"
                                    PreviewKeyDown="InputBox_PreviewKeyDown"
                                    ToolTip="Enter to send · Shift+Enter for a new line · Ctrl+V pastes a screenshot" />

                        <DockPanel Margin="4,2,6,6">
                            <ui:Button DockPanel.Dock="Right"
                                       Appearance="Primary"
                                       Command="{Binding SendCommand}"
                                       IsEnabled="{Binding CanChat}"
                                       Width="36"
                                       Height="32"
                                       Padding="0"
                                       ToolTip="Send (Enter)">
                                <ui:SymbolIcon Symbol="Send24" FontSize="16" />
                            </ui:Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Transparent" Padding="7,5" Click="AttachFile_Click"
                                           ToolTip="Attach files — RDLC, XML, JSON, TXT, AL, PDF… (or drop them here)">
                                    <ui:SymbolIcon Symbol="Attach24" FontSize="17" />
                                </ui:Button>
                                <ui:Button Appearance="Transparent" Padding="7,5" Click="AttachImage_Click"
                                           ToolTip="Attach an image — screenshot, report design, error message (or paste with Ctrl+V)">
                                    <ui:SymbolIcon Symbol="ImageAdd24" FontSize="17" />
                                </ui:Button>
                                <ui:Button Padding="7,5" Command="{Binding ToggleVoiceCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Transparent" />
                                            <Setter Property="ToolTip" Value="Voice input — dictate in English, then review the text and send" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="Appearance" Value="Danger" />
                                                    <Setter Property="ToolTip" Value="Stop listening" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Mic24" FontSize="17"
                                                       Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVis}}" />
                                        <ui:SymbolIcon Symbol="MicRecord24" FontSize="17" Filled="True"
                                                       Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </ui:Button>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1" Text="{Binding ComposerNotice}" FontSize="11" TextWrapping="Wrap" Margin="4,6,4,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Visibility="{Binding HasComposerNotice, Converter={StaticResource BoolToVis}}" />

                <!-- Provider + model picker: one button; a two-step popup (provider, then model) with search. -->
                <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
                    <Button x:Name="ModelPickerButton" DockPanel.Dock="Left" Click="ModelPicker_Click" Cursor="Hand"
                            Padding="8,4" Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            ToolTip="Switch provider or model">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF3FB950" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanChat}" Value="False">
                                                <Setter Property="Fill" Value="#FFD29922" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding CanChat, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ModelDisplayName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                           MaxWidth="170" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ProviderDisplayName}" FontSize="11" Opacity="0.55" Margin="7,0,0,0"
                                           VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="Set up a provider" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding NeedsProviderSetup, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="ChevronDown16" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.7" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <!-- Disclaimer -->
                <TextBlock Grid.Row="3" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="10.5" Opacity="0.55"
                           TextAlignment="Center" Text="REX can make mistakes." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
