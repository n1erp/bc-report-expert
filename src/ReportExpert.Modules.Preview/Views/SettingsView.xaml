<UserControl x:Class="ReportExpert.Modules.Preview.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:ReportExpert.Modules.Preview.Helpers">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis" />
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <helpers:ProviderNameConverter x:Key="ProviderNameConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Settings24" Margin="0,0,8,0" />
                    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text=" — changes save automatically" Margin="8,0,0,0" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           Opacity="0.6" FontSize="12"
                           Text="{Binding StatusMessage}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel MaxWidth="960" HorizontalAlignment="Stretch">

                <!-- Appearance + Preview -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Border CornerRadius="8" Padding="16"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding Theme, Mode=TwoWay}"
                                          Margin="0,0,0,16" />

                                <TextBlock Text="Layout designer" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="Rulers and gridlines on the RDLC design surface."
                                           FontSize="12" Opacity="0.6" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <ui:ToggleSwitch Content="Show rulers"
                                                 IsChecked="{Binding ShowDesignerRulers, Mode=TwoWay}"
                                                 Margin="0,0,0,8" />
                                <ui:ToggleSwitch Content="Show gridlines"
                                                 IsChecked="{Binding ShowDesignerGridlines, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Preview" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Border CornerRadius="8" Padding="16"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <!-- Sample rows: quick picks or any value 1–500; the summary pill shows what applies. -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="TableSimple24" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Sample data" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" CornerRadius="10" Padding="10,3"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="{Binding RowsSummary}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock FontSize="12" Opacity="0.65" Margin="0,0,0,12" TextWrapping="Wrap"
                                           Text="Rows Rex generates for each dataset when a report has no data file attached, in the designer preview and the RDLC preview. An attached Business Central XML, JSON or CSV file is always shown in full." />

                                <TextBlock Text="Rows per dataset" FontSize="12" Opacity="0.8" Margin="0,0,0,6" />
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ItemsControl ItemsSource="{Binding RowPresets}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Button Content="{Binding Label}"
                                                           MinWidth="52"
                                                           Padding="12,6"
                                                           Margin="0,0,6,6"
                                                           ToolTip="{Binding Label, StringFormat='{}{0} rows per dataset'}"
                                                           Command="{Binding DataContext.SetRowCountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}">
                                                    <ui:Button.Style>
                                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                            <Setter Property="Appearance" Value="Secondary" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Appearance" Value="Primary" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:Button.Style>
                                                </ui:Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,6" VerticalAlignment="Top">
                                        <TextBlock Text="or" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ui:NumberBox Width="116"
                                                      MinHeight="34"
                                                      SpinButtonPlacementMode="Inline"
                                                      Minimum="1"
                                                      Maximum="500"
                                                      MaxDecimalPlaces="0"
                                                      SmallChange="1"
                                                      LargeChange="10"
                                                      ClearButtonEnabled="False"
                                                      Value="{Binding RowsGenerated, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="Any number of rows from 1 to 500" />
                                        <TextBlock Text="rows" Opacity="0.6" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </WrapPanel>

                                <Border CornerRadius="6" Padding="10,8" Margin="0,6,0,0"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Info16" FontSize="14" Margin="0,0,8,0" Opacity="0.7" VerticalAlignment="Top" />
                                        <TextBlock FontSize="12" Opacity="0.75" TextWrapping="Wrap" MaxWidth="420"
                                                   Text="Changes apply the next time a preview renders: press Refresh on an open preview. Export dialogs open in the folder you last exported to." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Copilot AI: several providers, each with its own key and model; Rex uses one at a time. -->
                <StackPanel x:Name="ProvidersSection" Margin="0,0,0,20">
                    <TextBlock Text="Copilot AI providers" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="Set up as many providers as you like. Rex uses the active one, and you can switch provider and model from the Rex chat. A provider without a key, or whose key is rejected, is not offered there." />

                    <ItemsControl ItemsSource="{Binding ConfiguredProviders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,10"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Header: name, status, active badge, actions -->
                                        <DockPanel Margin="0,0,0,10">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <ui:Button Content="Use in Rex" Padding="10,3" Margin="0,0,6,0"
                                                           Command="{Binding ActivateCommand}"
                                                           Visibility="{Binding CanActivate, Converter={StaticResource BoolToVis}}"
                                                           ToolTip="Make this the provider Rex sends to" />
                                                <ui:Button Appearance="Transparent" Padding="6,3" Command="{Binding RemoveCommand}" ToolTip="Remove this provider and its key">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" />
                                                </ui:Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#22888888" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Ok">
                                                                    <Setter Property="Background" Value="#333FB950" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                                                    <Setter Property="Background" Value="#33D29922" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                                    <Setter Property="Background" Value="#33E5484D" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" />
                                                </Border>
                                                <Border CornerRadius="9" Padding="8,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Used by Rex" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- API key -->
                                        <Grid Margin="0,0,0,6" Visibility="{Binding NeedsKey, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="API key" VerticalAlignment="Center" Opacity="0.8" />
                                            <PasswordBox Grid.Column="1" Loaded="ProviderKeyBox_Loaded" PasswordChanged="ProviderKeyBox_PasswordChanged" />
                                            <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="Get key" Command="{Binding GetKeyCommand}" ToolTip="Open the provider's page to create an API key" />
                                            <ui:Button Grid.Column="3" Margin="8,0,0,0" Content="Test" Command="{Binding TestCommand}" ToolTip="Send a short request to check the key" />
                                        </Grid>
                                        <Grid Margin="0,0,0,6" Visibility="{Binding NeedsKey, Converter={StaticResource InverseBoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Key" VerticalAlignment="Center" Opacity="0.8" />
                                            <TextBlock Grid.Column="1" Text="Not needed — Ollama runs on this computer." VerticalAlignment="Center" Opacity="0.65" />
                                            <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="Test" Command="{Binding TestCommand}" ToolTip="Check that Ollama answers" />
                                        </Grid>

                                        <!-- Endpoint (Azure, Ollama) -->
                                        <Grid Margin="0,0,0,6" Visibility="{Binding ShowsEndpoint, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Endpoint" VerticalAlignment="Center" Opacity="0.8" />
                                            <ui:TextBox Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding EndpointPlaceholder}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,6" Visibility="{Binding IsAzure, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Deployment" VerticalAlignment="Center" Opacity="0.8" />
                                            <ui:TextBox Grid.Column="1" Text="{Binding AzureDeployment, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Deployment name (defaults to the model)" />
                                        </Grid>

                                        <!-- Model -->
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Model" VerticalAlignment="Center" Opacity="0.8" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding ModelOptions}" SelectedValuePath="ModelId"
                                                      SelectedValue="{Binding Model, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                            <TextBlock FontSize="11" Opacity="0.55" Text="{Binding BestFor}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>

                                        <TextBlock Text="{Binding TestMessage}" Margin="90,6,0,0" FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
                                        <TextBlock Text="{Binding KeyError}" Margin="90,2,0,0" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Visibility="{Binding HasKeyError, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,10" BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding HasConfiguredProviders, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                   Text="No provider yet. Add one below — Google Gemini has a free tier, and Ollama runs models locally without a key." />
                    </Border>

                    <!-- Add provider -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasAddableProviders, Converter={StaticResource BoolToVis}}">
                        <ComboBox ItemsSource="{Binding AddableProviders}" SelectedItem="{Binding ProviderToAdd, Mode=TwoWay}" MinWidth="220">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ProviderNameConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding AddProviderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Add provider" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>

                <!-- Agent mode and the MCP servers that provide its tools -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Agent mode" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Border CornerRadius="8" Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <ui:ToggleSwitch Content="Let Copilot edit reports"
                                             IsChecked="{Binding AgentModeEnabled, Mode=TwoWay}" />
                            <TextBlock Margin="0,6,0,16"
                                       FontSize="12"
                                       Opacity="0.65"
                                       TextWrapping="Wrap"
                                       Text="Copilot can inspect and change the open report using the tools below. You approve every change before it is made, and the file is backed up first." />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tool servers" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Edit list"
                                           Command="{Binding EditMcpConfigurationCommand}"
                                           ToolTip="{Binding McpConfigurationPath}" />
                                <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="Restart"
                                           Command="{Binding RestartMcpCommand}"
                                           IsEnabled="{Binding IsRefreshingMcp, Converter={StaticResource InverseBoolConverter}}"
                                           ToolTip="Reconnect, picking up any changes to the list" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding McpServers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4"
                                                Padding="12,8"
                                                CornerRadius="6"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                      ExpandDirection="Down">
                                                <Expander.Header>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Id}"
                                                                       FontWeight="SemiBold"
                                                                       FontFamily="Consolas"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Margin="10,0,0,0"
                                                                       FontSize="11"
                                                                       Opacity="0.7"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding ToolCountLabel}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Command}"
                                                                   FontSize="11"
                                                                   Opacity="0.55"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding LastError}"
                                                                   FontSize="11"
                                                                   Margin="0,4,0,0"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Expander.Header>

                                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Tools}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,2"
                                                                    Padding="8,6"
                                                                    CornerRadius="4"
                                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Margin="0,0,12,0">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontFamily="Consolas"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Text="{Binding Description}"
                                                                                   FontSize="11"
                                                                                   Opacity="0.6"
                                                                                   TextWrapping="Wrap"
                                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>
                                                                    <ui:ToggleSwitch Grid.Column="1"
                                                                                     VerticalAlignment="Center"
                                                                                     IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                                     ToolTip="When off, Copilot cannot call this tool" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Open source -->
                <TextBlock Text="Open source" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,12" />
                <Border CornerRadius="8" Padding="16" Margin="0,0,0,12"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Click="OnOpenRepository" Cursor="Hand" Padding="0" Margin="0,0,16,0"
                                Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                                ToolTip="Open the Report Expert repository on GitHub">
                            <Path Data="{DynamicResource Rex.GitHubMark}" Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                  Stretch="Uniform" Width="40" Height="40" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="This project is open source" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,10" FontSize="12"
                                       Text="Report Expert is free and open source (MIT licence). Browse the code, report a bug, request a feature or contribute on GitHub. Bug reports go through a short form so problems can be reproduced and fixed." />
                            <WrapPanel>
                                <ui:Button Content="View on GitHub" Icon="{ui:SymbolIcon Open24}" Click="OnOpenRepository" Margin="0,0,8,6" Appearance="Primary" />
                                <ui:Button Content="Report a bug" Icon="{ui:SymbolIcon Bug24}" Click="OnReportBug" Margin="0,0,8,6" />
                                <ui:Button Content="Request a feature" Icon="{ui:SymbolIcon Lightbulb24}" Click="OnRequestFeature" Margin="0,0,8,6" />
                                <ui:Button Content="All issues" Icon="{ui:SymbolIcon TaskListLtr24}" Click="OnOpenIssues" Margin="0,0,8,6" />
                            </WrapPanel>
                            <TextBlock FontSize="11" Opacity="0.55" Text="github.com/n1erp/bc-report-expert" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock HorizontalAlignment="Center" Margin="0,8,0,24" Opacity="0.6" FontSize="12"
                           Text="Version 3.0 Safi" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
